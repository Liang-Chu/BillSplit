# Copy to .env and edit. All settings can also be passed as environment variables.

DATA_DIR=./data                 # SQLite DB + local files live here
JWT_SECRET=please-change-me     # long random string: python -c "import secrets;print(secrets.token_urlsafe(48))"
DEFAULT_CURRENCY=USD            # currency for each new user's seeded groups
CORS_ORIGINS=["*"]              # JSON list; e.g. ["http://frontend:5173"]

# First super admin (only used when the database has no users yet)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now
ADMIN_DISPLAY_NAME=Admin

# Uploads
UPLOAD_MAX_MB=10

# Cloudflare R2 (optional). When all four are set, R2 is primary and local disk is the fallback.
# R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=billsplit
# R2_PRESIGN_SECONDS=300

# OCR
OCR_ENABLED=true
OCR_MAX_CONCURRENCY=1
OCR_MAX_QUEUE=3
OCR_TIMEOUT_SECONDS=30

# Background jobs (period rollover/freeze, R2 re-sync)
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=300
